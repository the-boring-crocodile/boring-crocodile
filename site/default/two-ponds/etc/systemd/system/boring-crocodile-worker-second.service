[Unit]
PartOf=boring-crocodile-mcp.target
Description=Boring Crocodile second environment worker
After=systemd-tmpfiles-setup.service local-fs.target boring-crocodile-task-second.socket

[Service]
Type=simple
User=boring-crocodile-second
Group=boring-crocodile-second
UMask=0007
ExecStart=/opt/boring-crocodile/current/bin/boring-crocodile-worker --config /etc/boring-crocodile/config.toml --environment second
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/boring-crocodile/workers /home/boring-crocodile-second
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
TasksMax=128

[Install]
WantedBy=boring-crocodile-mcp.target
