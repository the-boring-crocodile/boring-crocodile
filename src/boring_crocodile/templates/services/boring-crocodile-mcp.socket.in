[Unit]
PartOf=boring-crocodile-mcp.target
Description=Boring Crocodile root-held controller listener

[Socket]
ListenStream=@LISTEN_ADDRESS@
BindIPv6Only=ipv6-only
Accept=no
ReusePort=no
FileDescriptorName=controller
Service=boring-crocodile-mcp.service

[Install]
WantedBy=boring-crocodile-mcp.target
