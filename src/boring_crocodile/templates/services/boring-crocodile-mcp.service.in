[Unit]
PartOf=boring-crocodile-mcp.target
Description=Boring Crocodile MCP control plane
After=network-online.target boring-crocodile-worker-@POND@.service
Wants=network-online.target
Requires=boring-crocodile-worker-@POND@.service

[Service]
Type=simple
RuntimeDirectory=boring-crocodile-authority
RuntimeDirectoryMode=0755
StateDirectory=boring-crocodile
StateDirectoryMode=0700
UMask=0077
User=@CONTROL_USER@
Group=@CONTROL_USER@
SupplementaryGroups=@EXECUTION_USER@
Environment=BORING_CROCODILE_CONFIG=/etc/boring-crocodile/config.toml
LoadCredential=approval-secret:/etc/boring-crocodile/credentials/approval-secret
ExecStart=@RUNTIME@/bin/boring-crocodile-mcp
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/boring-crocodile
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
TasksMax=64

[Install]
WantedBy=boring-crocodile-mcp.target
